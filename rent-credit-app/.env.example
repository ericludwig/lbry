# Database
DATABASE_URL=postgresql+asyncpg://rentcredit:rentcredit@localhost:5432/rentcredit

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=change-this-in-production-minimum-32-chars

# Stripe (get from https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...
# Price IDs created in Stripe dashboard
STRIPE_RESIDENT_PRICE_ID=price_...
STRIPE_PM_PRODUCT_ID=prod_...

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-in-production

# Credit Bureau (Metro 2 reporting)
EXPERIAN_FTP_HOST=sftp.experian.com
EXPERIAN_FTP_USER=your_user
EXPERIAN_FTP_PASSWORD=your_password
EQUIFAX_FTP_HOST=sftp.equifax.com
EQUIFAX_FTP_USER=your_user
EQUIFAX_FTP_PASSWORD=your_password
TRANSUNION_FTP_HOST=sftp.transunion.com
TRANSUNION_FTP_USER=your_user
TRANSUNION_FTP_PASSWORD=your_password

# PMS Integration Keys
REALPAGE_API_KEY=your_key
REALPAGE_API_URL=https://api.realpage.com
YARDI_API_KEY=your_key
YARDI_API_URL=https://api.yardipcv.com
APPFOLIO_CLIENT_ID=your_client_id
APPFOLIO_CLIENT_SECRET=your_client_secret
APPFOLIO_API_URL=https://api.appfolio.com
ENTRATA_API_KEY=your_key
ENTRATA_API_URL=https://api.entrata.com

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# App config
RESIDENT_MONTHLY_FEE_CENTS=895
PM_MONTHLY_PAYOUT_CENTS=300
FREE_TRIAL_DAYS=30
ENVIRONMENT=development
